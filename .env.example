# ============================================================
# 万能视频下载网站 — 环境变量示例
# 复制为 .env 并按需修改。任何密钥仅存服务端，勿提交到 git。
# ============================================================

# ---- 服务监听 ----
HOST=0.0.0.0
PORT=8000

# ---- 下载 / 临时文件 ----
# 尽量用短路径，规避 Windows 260 长度限制
TEMP_DIR=D:/vdl_tmp
# 文件保留秒数，超时被后台清理
FILE_TTL_SECONDS=1800
# 同时下载的最大条数（后台线程池大小）
MAX_CONCURRENT_DOWNLOADS=2
# 单次批量下载的最大任务数
MAX_BATCH=8
# 后台清理循环间隔（秒）
CLEANUP_INTERVAL_SECONDS=60

# ---- ffmpeg（合并高清音视频流 = 必需）----
# 安装：winget install Gyan.FFmpeg
# 若未装到 PATH，可把 ffmpeg.exe/ffprobe.exe 所在目录填到这里
YTDLP_FFMPEG_LOCATION=

# ---- 可选：平台 cookies / 代理 ----
# X/YouTube 部分视频需登录；B 站部分视频的 AI 字幕需登录态(need_login_subtitle)才能取。
# 运营者可导出 cookies.txt(chrome/Netscape 格式，B 站宜含 SESSDATA)填此路径，仅供自测。
COOKIES_FILE=
# 形如 http://127.0.0.1:7890
PROXY=

# ---- 抖音（服务端无头浏览器）----
# 服务器需装有 Chrome/Edge（Playwright 复用系统 Chrome，无需下载 Chromium）。
# 用浏览器匿名游客会话加载抖音页，拦截页面真实 aweme/detail 响应拿播放地址；
# 无需用户 Cookie、无需浏览器插件。关闭后抖音走友好降级提示，不影响其他平台。
DOUYIN_ENABLED=true
# 无头模式；需人工确认验证码时临时设 false 可视调试
DOUYIN_HEADLESS=true
# 读取抖音详情页的超时（秒），风控时调大
DOUYIN_TIMEOUT_SECONDS=45
# 预留：风控触发时自动刷新游客会话（当前未启用硬刷新）
DOUYIN_AUTO_REFRESH=true

# ---- SEO ----
# 生产域名（不带末尾斜杠），用于 canonical / og:url / sitemap 等绝对 URL。
# 未配置时页面用相对路径占位；正式上线（M3）后填入，如 https://example.com
SITE_BASE_URL=

# ---- GEO（AI 搜索引擎优化）----
# IndexNow key（Bing/ChatGPT 搜索源主动推送验证）。生成：powershell [guid]::NewGuid().ToString("N")
# 验证文件路由：/{INDEXNOW_KEY}.txt；上线后把首页/教程 URL POST 到 https://api.indexnow.org/ 提交
INDEXNOW_KEY=

# ---- 安全 / 限流 ----
# 每分钟每 IP 可解析次数
RATE_PARSE_PER_MIN=20
# 每分钟每 IP 可发起下载次数
RATE_DOWNLOAD_PER_MIN=6
# 每分钟每 IP 可调用 AI 次数（字幕提取/翻译、摘要、章节、导图、问答共用一个桶）
RATE_AI_PER_MIN=30
# 提取器白名单（ie_key，逗号分隔；留空 = 全平台）。例：YouTube,BiliBili,ArchiveOrg
EXTRACTOR_ALLOWLIST=
# 仅当前端跨域部署时才放开为你的域，同源部署留空
ALLOWED_ORIGIN=
# 可选：请求头 X-App-Token 鉴权令牌，留空关闭
APP_TOKEN=

# ---- LLM（OpenAI 兼容接口，用于字幕翻译 / AI 摘要）----
# 支持 DeepSeek / 智谱 / 星火等任何 OpenAI 兼容服务
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
# 单次把字幕送入 LLM 的最大字符数，超长截断
AI_MAX_CHARS=120000
AI_TIMEOUT_SECONDS=90
# ---- 学习型结构化摘要（v2：章节 + 时间戳 + 思维导图 + AI 问答）----
# 字幕少于该字符数时用「单次直出结构化摘要」；超过则走「分块 map-reduce」
AI_SINGLE_SHOT_CHARS=30000
# 分块 map-reduce：每个章节的最大字符预算
AI_CHAPTER_MAX_CHARS=8000
# 分块 map-reduce：最大章节数
AI_MAX_CHAPTERS=20
# 分块 map-reduce：map 阶段并发的 LLM 调用数
AI_MAP_CONCURRENCY=3
# AI 问答：上下文（相关性章节）最大字符数
AI_CHAT_CONTEXT_CHARS=15000
# 字幕稿缓存（AI 问答复用，避免每轮重复提取）TTL 秒
TRANSCRIPT_CACHE_TTL_SECONDS=600

# ---- 会员账户 / Stripe 支付（v0.7.0）----
# Stripe 测试密钥（Dashboard 开发者→API 密钥，sk_test_ 开头）。留空=支付功能关闭（端点 503，不影响其他功能）
STRIPE_SECRET_KEY=
# Webhook 签名密钥：本地测试用 `stripe listen` 输出的 whsec_...；上线后在 Dashboard 配置端点获取
STRIPE_WEBHOOK_SECRET=
# 两个「一次性」价格 ID（Products→Prices，One-off，非 Recurring）：月卡=30 天、年卡=365 天
STRIPE_PRICE_MONTH=
STRIPE_PRICE_YEAR=
# 注册/登录 每IP每分钟次数（防爆破/批量注册）
RATE_AUTH_PER_MIN=5
# 创建支付会话 每IP每分钟次数（防刷单）
RATE_BILLING_PER_MIN=5
# 非 PRO 每日 AI 次数上限（游客按 IP、免费账户按 user_id）；PRO 不限日次数
AI_FREE_DAILY_LIMIT=3
# PRO 每分钟 AI 限流（高于免费桶 RATE_AI_PER_MIN）
RATE_AI_PRO_PER_MIN=60
# 免费用户可选的最大视频高度（像素）；高于此值为 PRO 专属，0=不封顶
FREE_MAX_HEIGHT=720

# ---- 设备无关 UA，规避平台基础反爬 ----
YTDLP_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
